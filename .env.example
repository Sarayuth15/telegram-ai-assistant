# Telegram (server-side only; never prefix with NEXT_PUBLIC_)
# Bot token from @BotFather. Required to send Telegram replies.
TELEGRAM_BOT_TOKEN=
# Random string (A-Z, a-z, 0-9, _ or -). Must match the secret_token passed to setWebhook.
# If unset, the webhook endpoint responds 503.
TELEGRAM_WEBHOOK_SECRET=

# Scheduled messages
# Numeric chat ID that receives the Monday greeting. Send /myid to the bot to get it.
TELEGRAM_OWNER_CHAT_ID=
# Random string, at least 16 characters (e.g. `openssl rand -hex 32`).
# Vercel sends it as "Authorization: Bearer <CRON_SECRET>" on cron calls.
# If unset, the cron endpoint responds 503.
CRON_SECRET=

# AI provider - postponed. No provider is connected, so this value is currently unused.
AI_API_KEY=
